{"id":1,"name":"Opening Narration","note":"","pages":[{"conditions":{"actorId":1,"actorValid":false,"itemId":1,"itemValid":false,"selfSwitchCh":"A","selfSwitchValid":false,"switch1Id":1,"switch1Valid":false,"switch2Id":1,"switch2Valid":false,"variableId":1,"variableValid":false,"variableValue":0},"directionFix":false,"image":{"tileId":0,"characterName":"","direction":2,"pattern":0,"characterIndex":0},"list":[{"code":108,"indent":0,"parameters":["The opening. Thenmy narrates (the player isn't told who). The party becomes the Ghost alone."]},{"code":355,"indent":0,"parameters":["$gameParty._actors = [1]; $gamePlayer.refresh();"]},{"code":211,"indent":0,"parameters":[0]},{"code":108,"indent":0,"parameters":["PICTURE (optional): Show Picture here for each line, e.g. the sea, the fleet, the smoking peak."]},{"code":101,"indent":0,"parameters":["",0,1,1]},{"code":401,"indent":0,"parameters":["My father once said that at the center of the world, there is an island that birthed The Sun."]},{"code":101,"indent":0,"parameters":["",0,1,1]},{"code":401,"indent":0,"parameters":["The world is a great bowl, he said, and the sea pools in it. In the middle, where The Sun first rose, a mountain still smokes."]},{"code":101,"indent":0,"parameters":["",0,1,1]},{"code":401,"indent":0,"parameters":["The islanders say a demon stole a star from the sky, and a burning bird stole the star back and dropped it too low into the sky, and this is where The Sun comes from."]},{"code":101,"indent":0,"parameters":["",0,1,1]},{"code":401,"indent":0,"parameters":["My father says that the God of the World set it there for him. His son."]},{"code":101,"indent":0,"parameters":["",0,1,1]},{"code":401,"indent":0,"parameters":["I have read every chart and tablet the Navigators left. They agree on only one thing:"]},{"code":101,"indent":0,"parameters":["",0,1,1]},{"code":401,"indent":0,"parameters":["Whoever holds the island holds the center of the world."]},{"code":101,"indent":0,"parameters":["",0,1,1]},{"code":401,"indent":0,"parameters":["Sixty-five years ago my father sailed out to win that world. Now he is old, and he has sent me to finish his world."]},{"code":101,"indent":0,"parameters":["",0,1,1]},{"code":401,"indent":0,"parameters":["I am told the islanders are like children. Small, tattooed, afraid of their own dead. We have friends among them."]},{"code":101,"indent":0,"parameters":["",0,1,1]},{"code":401,"indent":0,"parameters":["I am told there will be very little blood."]},{"code":221,"indent":0,"parameters":[]},{"code":230,"indent":0,"parameters":[60]},{"code":250,"indent":0,"parameters":[{"name":"Water1","volume":60,"pitch":120,"pan":0}]},{"code":230,"indent":0,"parameters":[45]},{"code":250,"indent":0,"parameters":[{"name":"Water1","volume":55,"pitch":115,"pan":0}]},{"code":230,"indent":0,"parameters":[45]},{"code":250,"indent":0,"parameters":[{"name":"Water1","volume":50,"pitch":110,"pan":0}]},{"code":230,"indent":0,"parameters":[90]},{"code":123,"indent":0,"parameters":["A",0]},{"code":201,"indent":0,"parameters":[0,6,8,5,2,2]},{"code":0,"indent":0,"parameters":[]}],"moveFrequency":3,"moveRoute":{"list":[{"code":0,"parameters":[]}],"repeat":true,"skippable":false,"wait":false},"moveSpeed":3,"moveType":0,"priorityType":1,"stepAnime":false,"through":false,"trigger":3,"walkAnime":true},{"conditions":{"actorId":1,"actorValid":false,"itemId":1,"itemValid":false,"selfSwitchCh":"A","selfSwitchValid":true,"switch1Id":1,"switch1Valid":false,"switch2Id":1,"switch2Valid":false,"variableId":1,"variableValid":false,"variableValue":0},"directionFix":false,"image":{"tileId":0,"characterName":"","direction":2,"pattern":0,"characterIndex":0},"list":[{"code":0,"indent":0,"parameters":[]}],"moveFrequency":3,"moveRoute":{"list":[{"code":0,"parameters":[]}],"repeat":true,"skippable":false,"wait":false},"moveSpeed":3,"moveType":0,"priorityType":1,"stepAnime":false,"through":false,"trigger":0,"walkAnime":true}],"x":8,"y":6}
